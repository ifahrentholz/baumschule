---
// Sveltia CMS editing UI (D3). Self-hosted: the npm package is bundled into
// the build, so the page loads no script from a CDN. The configuration is
// passed in full (src/cms-config.ts), so the page works below any base path.
// Always noindex, in the production build too: the editor UI is not content.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Baumschule Fischer – Inhalte</title>
  </head>
  <body>
    <script>
      import CMS from "@sveltia/cms";
      import { createCmsConfig } from "../../cms-config";

      const siteUrl = new URL(import.meta.env.BASE_URL, window.location.origin)
        .href;
      CMS.init({ config: createCmsConfig({ siteUrl }) });
    </script>
  </body>
</html>
